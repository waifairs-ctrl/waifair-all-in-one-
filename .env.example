# Firebase Web App configuration (use the values from Firebase Console > Project settings)
# The app can also read its bundled firebase-applet-config.json fallback.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Keep '(default)' unless the Firebase project has a separately-created named Firestore database.
VITE_FIREBASE_DATABASE_ID=(default)

# Add only if a server-side Gemini integration is implemented.
# Never expose private API keys with a VITE_ prefix.
GEMINI_API_KEY=
